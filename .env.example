
# 模型配置
# 截止开发时间2026.11.19, 默认模型选用 deepseek.com 提供的 deepseek-v4-pro

# 配置模型来源 本地模拟填mock openai兼容写openai anthropic兼容写anthropic
MODEL_PROVIDER: openai
# 在这里输入模型供应方指定的api接口地址
API_URL: https://api.deepseek.com/chat/completions
# 在这里输入你的云端大模型apikey
API_KEY: example_api_key
# 在这里写入你想选用的模型名称，从模型供应方文档中获取
MODEL_NAME: deepseek-v4-pro


# QQBot 配置
# 请前往 QQ 开放平台 https://q.qq.com/qqbot/dashboard/ 创建并配置机器人
BOT_APP_ID: 10000000001
BOT_APP_SECRET: example_qq_bot_sec


# 机器人邮箱配置



# 数据库用户名、密码配置
# 数据库选用请在 config 中配置，这里只存储登录凭证
DB_USERNAME: ShiYi_your_ai_assistant
DB_PASSWORD: example_password
